$TTL 3600
@   IN  SOA ns1.livingsacrifice.my.id. admin.livingsacrifice.my.id. (
        2026111602  ; serial, naikkan setiap kali zone diubah
        3600        ; refresh
        900         ; retry
        1209600     ; expire
        300 )       ; negative cache TTL

@       IN  NS  ns1.livingsacrifice.my.id.
@       IN  A   127.0.0.1
ns1     IN  A   127.0.0.1
www     IN  A   127.0.0.1
mail    IN  A   127.0.0.1
blog    IN  CNAME   www.livingsacrifice.my.id.
@       IN  MX  10  mail.livingsacrifice.my.id.
@       IN  TXT     "zona DNS lokal untuk belajar"
